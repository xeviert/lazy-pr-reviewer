{
  "name": "lazy-pr-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Explains pull requests instead of judging them.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dry-run": "tsx --env-file-if-exists=.env scripts/dry-run.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^0.128.0",
    "picomatch": "^4.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
